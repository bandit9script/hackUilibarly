        else
            page.Visible = false
            btn.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
            btn.TextColor3 = THEME.Green
        end
    end
end

local function updatePageCanvas(page)
    local maxBottom = 0
    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("GuiObject") then
            local bottom = child.Position.Y.Offset + child.Size.Y.Offset
            if bottom > maxBottom then
                maxBottom = bottom
            end
        end
    end
    page.CanvasSize = UDim2.new(0, 0, 0, maxBottom + 30)
end

