local function showConfirmDialog(message, onConfirm, onCancel)
    if modalConfirmConn then modalConfirmConn:Disconnect() end
    if modalCancelConn then modalCancelConn:Disconnect() end

    modalMessage.Text = message or "Are you sure you want to proceed?"
    modalOverlay.Visible = true
    modalOverlay.BackgroundTransparency = 1
    modalBox.Size = UDim2.new(0, 0, 0, 0)

    TweenService:Create(modalOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
    TweenService:Create(modalBox, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 280, 0, 130)
    }):Play()

    local function closeModal()
        TweenService:Create(modalBox, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()
        TweenService:Create(modalOverlay, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        task.delay(0.15, function()
            modalOverlay.Visible = false
        end)
    end

    modalConfirmConn = modalConfirmBtn.MouseButton1Click:Connect(function()
        closeModal()
        API.Callbacks.OnDialogConfirm()
        if onConfirm then onConfirm() end
    end)
    modalCancelConn = modalCancelBtn.MouseButton1Click:Connect(function()
        closeModal()
        API.Callbacks.OnDialogCancel()
        if onCancel then onCancel() end
    end)
end

