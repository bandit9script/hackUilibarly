local deathEffectEnabled = false

local function SetupTeamTracking()
    local charactersFolder = Workspace:WaitForChild("Characters", 5)
    if not charactersFolder then return end

    local tFolder = charactersFolder:WaitForChild("Terrorists", 5)
    local ctFolder = charactersFolder:WaitForChild("Counter-Terrorists", 5)

    local myChar = player.Character or player.CharacterAdded:Wait()
    local enemyFolder = nil
    
    if tFolder and tFolder:FindFirstChild(myChar.Name) then
        enemyFolder = ctFolder
    elseif ctFolder and ctFolder:FindFirstChild(myChar.Name) then
        enemyFolder = tFolder
    end

    if enemyFolder then
        enemyFolder.ChildRemoved:Connect(function(child)
            if child:IsA("Model") and deathEffectEnabled then
                PlaySoulFogOnTarget(child, false)
            end
        end)
    end
end

player.CharacterAdded:Connect(function()
    task.wait(1)
    SetupTeamTracking()
end)

task.spawn(SetupTeamTracking)

