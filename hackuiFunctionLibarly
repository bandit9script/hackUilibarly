-- ЭФФЕКТ SOUL FOG (УЛЬТРА ОПТИМИЗИРОВАННЫЙ)
------------------------------------------------------------
local BALLS_PER_PART = 30
local MAX_TOTAL_BALLS = 300
local activeEffects = {}

local function FadeOutEffect(Balls, targetCharacter, isPreview, onComplete)
    if not Balls or #Balls == 0 then
        if isPreview and targetCharacter and targetCharacter.Parent then
            for _, d in ipairs(targetCharacter:GetDescendants()) do
                if d:IsA("BasePart") or d:IsA("Decal") then
                    d.Transparency = 0
                end
            end
        end
        if onComplete then onComplete() end
        return
    end

    for k = 1, #Balls do
        local data = Balls[k]
        if data.Fog then
            data.Fog.Enabled = false
        end
    end

    task.spawn(function()
        for step = 1, 10 do
            local t = step / 10
            for k = 1, #Balls do
                local data = Balls[k]
                local ball = data.Part
                if ball and ball.Parent then
                    ball.Transparency = 0.1 + t * 0.9
                    ball.Size = ball.Size * 0.9
                end
            end
            task.wait(0.015)
        end

        for k = 1, #Balls do
            local data = Balls[k]
            if data.Part and data.Part.Parent then
                data.Part:Destroy()
            end
        end

        if isPreview and targetCharacter and targetCharacter.Parent then
            for _, d in ipairs(targetCharacter:GetDescendants()) do
                if d:IsA("BasePart") or d:IsA("Decal") then
                    d.Transparency = 0
                end
            end
        end

        if onComplete then
            onComplete()
        end
    end)
end

local function PlaySoulFogOnTarget(targetCharacter, isPreview, onEffectFinished)
    if not targetCharacter or not targetCharacter.Parent then
        if onEffectFinished then onEffectFinished() end
        return
    end

    local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        if onEffectFinished then onEffectFinished() end
        return
    end

    for i = #activeEffects, 1, -1 do
        FadeOutEffect(activeEffects[i], targetCharacter, isPreview)
        table.remove(activeEffects, i)
    end

    -- Скрываем оригинальные детали (включая превью в ViewportFrame)
    for _, d in ipairs(targetCharacter:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Transparency = 1
        elseif d:IsA("Decal") then
            d.Transparency = 1
        end
    end

    local Balls = {}
    local totalCreated = 0

    local descendants = targetCharacter:GetDescendants()
    local validParts = {}
    
    for i = 1, #descendants do
        local part = descendants[i]
        if part and part:IsA("BasePart") then
            table.insert(validParts, part)
        end
    end

    local ballsPerPart = isPreview and 8 or BALLS_PER_PART
    if #validParts > 0 then
        local maxAllowedPerPart = math.floor(MAX_TOTAL_BALLS / #validParts)
        if maxAllowedPerPart < ballsPerPart then
            ballsPerPart = math.max(1, maxAllowedPerPart)
        end
    end

    table.insert(activeEffects, Balls)

    task.spawn(function()
        for i = 1, #validParts do
            local found = false
            for _, b in ipairs(activeEffects) do
                if b == Balls then found = true break end
            end
            if not found then break end

            local part = validParts[i]
            if part and part.Parent then
                local partCFrame = part.CFrame
                local sizeX, sizeY, sizeZ = part.Size.X, part.Size.Y, part.Size.Z

                for j = 1, ballsPerPart do
                    local ball = Instance.new("Part")
                    ball.Shape = Enum.PartType.Ball
                    ball.Size = Vector3.new(0.2, 0.2, 0.2)
                    ball.Material = Enum.Material.Neon
                    ball.Color = Color3.fromRGB(170, 0, 255)
                    ball.CanCollide = false
                    ball.Anchored = true
                    ball.TopSurface = Enum.SurfaceType.Smooth
                    ball.BottomSurface = Enum.SurfaceType.Smooth
                    ball.Transparency = 0.1

                    local offset = Vector3.new(
                        (math.random() - 0.5) * (sizeX * 0.7),
                        (math.random() - 0.5) * (sizeY * 0.7),
                        (math.random() - 0.5) * (sizeZ * 0.7)
                    )
                    
                    local initialCFrameOffset = partCFrame:ToObjectSpace(partCFrame * CFrame.new(offset))

                    ball.CFrame = partCFrame * CFrame.new(offset)
                    ball.Parent = targetCharacter.Parent

                    local fog = Instance.new("ParticleEmitter")
                    fog.Parent = ball
                    fog.Texture = "rbxasset://textures/particles/smoke_main.dds"
                    fog.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(210, 80, 255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 0, 150))
                    })
                    fog.LightEmission = 0.5
                    fog.Rate = 2
                    fog.Lifetime = NumberRange.new(0.5, 0.8)
                    fog.Speed = NumberRange.new(0.01, 0.03)
                    fog.Drag = 8
                    fog.RotSpeed = NumberRange.new(-15, 15)
                    fog.Rotation = NumberRange.new(0, 360)
                    fog.SpreadAngle = Vector2.new(180, 180)
                    fog.Size = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.1),
                        NumberSequenceKeypoint.new(0.5, 0.2),
                        NumberSequenceKeypoint.new(1, 0.3)
                    })
                    fog.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.6),
                        NumberSequenceKeypoint.new(0.6, 0.8),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    fog.Enabled = true

                    totalCreated = totalCreated + 1
                    Balls[totalCreated] = { 
                        Part = ball, 
                        Fog = fog, 
                        BasePart = part, 
                        Offset = initialCFrameOffset,
                        Height = offset.Y,
                        RandomSeed = math.random() * 50,
                        LimitX = sizeX * 0.3,
                        LimitY = sizeY * 0.3,
                        LimitZ = sizeZ * 0.3
                    }
                end
            end
            task.defer(task.wait)
        end
    end)

    task.spawn(function()
        local timePassed = 0
        while true do
            local found = false
            for _, b in ipairs(activeEffects) do
                if b == Balls then found = true break end
            end
            if not found then break end

            timePassed = timePassed + 0.08

            for k = 1, #Balls do
                local data = Balls[k]
                local ball = data.Part
                local sourcePart = data.BasePart

                if ball and ball.Parent and sourcePart and sourcePart.Parent then
                    local baseCF = sourcePart.CFrame
                    
                    local currentUpOffset = 0
                    if not isPreview then
                        local activationDelay = (1.5 - data.Height * 0.6) 
                        local pullProgress = math.clamp((timePassed - activationDelay) * 0.5, 0, 1)
                        pullProgress = pullProgress * pullProgress * (3 - 2 * pullProgress)
                        currentUpOffset = pullProgress * 4.0
                    end

                    local jitterX = math.clamp((math.noise(timePassed * 3, data.RandomSeed, 0) - 0.5) * data.LimitX, -data.LimitX, data.LimitX)
                    local jitterY = math.clamp((math.noise(0, timePassed * 3, data.RandomSeed) - 0.5) * data.LimitY, -data.LimitY, data.LimitY)
                    local jitterZ = math.clamp((math.noise(data.RandomSeed, 0, timePassed * 3) - 0.5) * data.LimitZ, -data.LimitZ, data.LimitZ)

                    ball.CFrame = baseCF * data.Offset + Vector3.new(jitterX, jitterY, jitterZ) + Vector3.new(0, currentUpOffset, 0)

                    if data.Fog then
                        data.Fog.Rate = isPreview and 2 or 6
                    end
                end
            end
            task.wait(0.08)
        end
    end)

    if isPreview then
        task.spawn(function()
            task.wait(5.0)
            for i = #activeEffects, 1, -1 do
                if activeEffects[i] == Balls then
                    FadeOutEffect(Balls, targetCharacter, true, function()
                        if onEffectFinished then onEffectFinished() end
                    end)
                    table.remove(activeEffects, i)
                    break
                end
            end
        end)
    else
        task.spawn(function()
            task.wait(5.0)
            for i = #activeEffects, 1, -1 do
                if activeEffects[i] == Balls then
                    FadeOutEffect(Balls, targetCharacter, false)
                    table.remove(activeEffects, i)
                    if targetCharacter and targetCharacter.Parent then
                        targetCharacter:Destroy()
                    end
                    break
                end
            end
        end)
    end
end

