bootLabel.TextSize = 14
bootLabel.TextColor3 = THEME.Green
bootLabel.TextXAlignment = Enum.TextXAlignment.Left
bootLabel.TextYAlignment = Enum.TextYAlignment.Top
bootLabel.TextWrapped = true
bootLabel.Text = ""
bootLabel.ZIndex = 15
bootLabel.Parent = bootFrame

local BOOT_LINES = {
    "> connecting to bandit9.core ...",
    "> access token accepted",
    "> loading modules [player] [visual] [config] ...",
    "> decrypting interface ...",
    "> welcome, " .. (player.Name or "user"),
}

local function playBootSequence(onDone)
    bootFrame.Visible = true
    bootFrame.BackgroundTransparency = 0
    bootLabel.TextTransparency = 0
    bootLabel.Text = ""
    task.spawn(function()
        local full = ""
        for _, line in ipairs(BOOT_LINES) do
            for i = 1, #line do
                bootLabel.Text = full .. string.sub(line, 1, i) .. "_"
                task.wait(0.008)
            end
            full = full .. line .. "\n"
            bootLabel.Text = full
            task.wait(0.15)
        end
        task.wait(0.25)
        TweenService:Create(bootFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(bootLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        task.wait(0.3)
        bootFrame.Visible = false
        bootFrame.BackgroundTransparency = 0
        bootLabel.TextTransparency = 0
        if onDone then onDone() end
    end)
end

local SHUTDOWN_LINES = {
    "> saving session ...",
    "> closing modules [player] [visual] [config] ...",
    "> decrypting interface ...",
    "> connection terminated_",
}

local function playShutdownSequence(onDead)
    bootFrame.Visible = true
    bootFrame.BackgroundTransparency = 0
    bootLabel.TextTransparency = 0
    bootLabel.Text = ""
    task.spawn(function()
        local full = ""
        for _, line in ipairs(SHUTDOWN_LINES) do
            for i = 1, #line do
                bootLabel.Text = full .. string.sub(line, 1, i) .. "_"
                task.wait(0.006)
            end
            full = full .. line .. "\n"
            bootLabel.Text = full
            task.wait(0.12)
        end
        task.wait(0.15)
        if onDead then onDead() end
    end)
end

local function glitchShake(frame, duration)
    duration = duration or 0.25
    originalPos = frame.Position
    task.spawn(function()
        local t = 0
        while t < duration do
            local dx = math.random(-4, 4)
            local dy = math.random(-3, 3)
            frame.Position = originalPos + UDim2.new(0, dx, 0, dy)
            task.wait(0.03)
            t = t + 0.03
        end
        frame.Position = originalPos
    end)
end

local isOpen = false
local closing = false
local targetSize = UDim2.new(0, 560, 0, 360)

local function openMenu()
    if isOpen or closing then return end
    isOpen = true

    matrixHolder.Visible = true
    startMatrix()
    for _, c in ipairs(columns) do
        c.label.TextTransparency = 1
        TweenService:Create(c.label, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {TextTransparency = 0.15}):Play()
    end

    main.Visible = true
    main.Size = UDim2.new(0, 0, 0, 0)
    main.BackgroundTransparency = 0
    main.Rotation = -3

    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = targetSize,
        Rotation = 0,
    }):Play()

    TweenService:Create(mainStroke, TweenInfo.new(0.4), {Transparency = 0.1}):Play()
    TweenService:Create(glow1, TweenInfo.new(0.4), {Transparency = 0.85}):Play()

    TweenService:Create(watermark, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 8)
    }):Play()

    task.delay(0.15, function()
        glitchShake(main, 0.2)
    end)

    playBootSequence(function()
        if not activeTab then
            setActiveTab(SECTIONS[1].Name, SECTIONS[1].Cmd)
        end
    end)
end

local function closeMenu()
    if not isOpen or closing then return end
    closing = true

    playShutdownSequence(function()
        isOpen = false
        glitchShake(main, 0.18)

        task.delay(0.12, function()
            local tw = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Rotation = 4,
            })
            TweenService:Create(mainStroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(glow1, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(watermark, TweenInfo.new(0.3), {
                Position = UDim2.new(0.5, 0, 0, -40)
            }):Play()

            for _, c in ipairs(columns) do
                TweenService:Create(c.label, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
            end

            tw:Play()
            tw.Completed:Connect(function()
                main.Visible, main.Rotation, matrixHolder.Visible, isOpen, closing = false, 0, false, false, false
                activeTab = nil
                bootFrame.Visible = false
            end)
        end)
    end)
end

local function toggleMenu()
    if closing then return end
    if isOpen then closeMenu() else openMenu() end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == KEY_TO_TOGGLE then
        toggleMenu()
    end
end)

task.wait(0.5)
openMenu()
