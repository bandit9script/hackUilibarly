-- ОТКРЫТИЕ / ЗАКРЫТИЕ МЕНЮ
------------------------------------------------------------
local isOpen = false
local closing = false
local targetSize = UDim2.new(0, 560, 0, 360)

local function openMenu()
    if isOpen or closing then return end
    isOpen = true

    matrixHolder.Visible = true
    startMatrix()
    for _, c in ipairs(columns) do
        c.label.TextTransparency = 1
        TweenService:Create(c.label, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {TextTransparency = 0.15}):Play()
    end

    main.Visible = true
    main.Size = UDim2.new(0, 0, 0, 0)
    main.BackgroundTransparency = 0
    main.Rotation = 0

    main.Rotation = -3
    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = targetSize,
        Rotation = 0,
    }):Play()

    TweenService:Create(mainStroke, TweenInfo.new(0.4), {Transparency = 0.1}):Play()
    TweenService:Create(glow1, TweenInfo.new(0.4), {Transparency = 0.85}):Play()

    TweenService:Create(watermark, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 8)
    }):Play()

    task.delay(0.15, function()
        glitchShake(main, 0.2)
    end)

    playBootSequence(function()
        if not activeTab then
            setActiveTab(SECTIONS[1].Name, SECTIONS[1].Cmd)
        end
    end)

    task.spawn(function()
        task.wait(0.5)
        while isOpen do
            TweenService:Create(glow1, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Transparency = 0.65, Thickness = 6
            }):Play()
            task.wait(1.4)
            if not isOpen then break end
            TweenService:Create(glow1, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Transparency = 0.88, Thickness = 4
            }):Play()
            task.wait(1.4)
        end
    end)
end

local function closeMenu()
    if not isOpen or closing then return end
    closing = true

    playShutdownSequence(function()
        isOpen = false

        glitchShake(main, 0.18)

        task.delay(0.12, function()
            local tw = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Rotation = 4,
            })
            TweenService:Create(mainStroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(glow1, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(watermark, TweenInfo.new(0.3), {
                Position = UDim2.new(0.5, 0, 0, -40)
            }):Play()

            for _, c in ipairs(columns) do
                TweenService:Create(c.label, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
            end

            tw:Play()
            tw.Completed:Connect(function()
                main.Visible = false
                main.Rotation = 0
                matrixHolder.Visible = false
                stopMatrix()
                activeTab = nil
                bootFrame.Visible = false
                closing = false
            end)
        end)
    end)
end

local function toggleMenu()
    if closing then return end
    if isOpen then
        closeMenu()
    else
        openMenu()
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == KEY_TO_TOGGLE then
        toggleMenu()
    end
end)

