        -- Камера медленно облетает персонажа по кругу, достаточно далеко, чтобы был виден целиком
        local vpSpin = 0
        RunService.RenderStepped:Connect(function(dt)
            if charClone and charClone.Parent then
                local hrp = charClone:FindFirstChild("HumanoidRootPart")
                if hrp then
                    vpSpin = vpSpin + dt * 0.5
                    local radius = 9 -- расстояние камеры от персонажа (увеличь, если всё ещё обрезает)
                    local center = hrp.Position -- целимся в центр персонажа (не в голову/ноги)
                    vpCamera.CFrame = CFrame.new(
                        center + Vector3.new(math.sin(vpSpin) * radius, 1.5, math.cos(vpSpin) * radius),
                        center
                    )
                end
            end
        end)

        local y = 250

        addLabel(page, "// visual: spinning ball toggle (shows photo window)", y)
        y = y + 18

        -- Шарик, который крутится влево-вправо, когда тумблер включён
        local ballHolder = Instance.new("Frame")
        ballHolder.Position = UDim2.new(0, 0, 0, y)
        ballHolder.Size = UDim2.new(0, 40, 0, 40)
        ballHolder.BackgroundTransparency = 1
        ballHolder.ZIndex = 6
        ballHolder.Parent = page

        local ball = Instance.new("Frame")
        ball.Size = UDim2.new(1, 0, 1, 0)
        ball.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
        ball.ZIndex = 6
        ball.Parent = ballHolder
        local ballCorner = Instance.new("UICorner")
        ballCorner.CornerRadius = UDim.new(1, 0)
        ballCorner.Parent = ball
        local ballStroke = addBorder(ball)

        -- полоска-индикатор внутри шарика, чтобы вращение было заметно
        local ballMark = Instance.new("Frame")
        ballMark.AnchorPoint = Vector2.new(0.5, 0)
        ballMark.Position = UDim2.new(0.5, 0, 0, 2)
        ballMark.Size = UDim2.new(0, 3, 0, 10)
        ballMark.BackgroundColor3 = THEME.Green
        ballMark.BorderSizePixel = 0
        ballMark.ZIndex = 7
        ballMark.Parent = ball

        local ballToggleBtn = Instance.new("TextButton")
        ballToggleBtn.Position = UDim2.new(0, 60, 0, y + 4)
        ballToggleBtn.Size = UDim2.new(0, 130, 0, 32)
        ballToggleBtn.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
        ballToggleBtn.AutoButtonColor = false
        ballToggleBtn.Font = Enum.Font.RobotoMono
        ballToggleBtn.TextSize = 14
        ballToggleBtn.TextColor3 = THEME.Green
        ballToggleBtn.Text = "[ ВКЛ / ВЫКЛ ]"
        ballToggleBtn.ZIndex = 6
        ballToggleBtn.Parent = page

        local ballBtnCorner = Instance.new("UICorner")
        ballBtnCorner.CornerRadius = UDim.new(0, 4)
        ballBtnCorner.Parent = ballToggleBtn
        local ballBtnStroke = addBorder(ballToggleBtn)

        animatePress(ballToggleBtn, ballBtnStroke)
        animateHover(ballToggleBtn, Color3.fromRGB(6, 15, 10), THEME.GreenSoft)
        clickScan(ballToggleBtn)

        local ballSpinning = false
        local ballConn

        local function startBallSpin()
            if ballConn then return end
            local angle = 0
            local dir = 1
            ballConn = RunService.RenderStepped:Connect(function(dt)
                angle = angle + dir * dt * 180 -- градусов в секунду
                if angle > 35 then dir = -1 end
                if angle < -35 then dir = 1 end
                ball.Rotation = angle
            end)
        end
        local function stopBallSpin()
            if ballConn then
                ballConn:Disconnect()
                ballConn = nil
            end
            TweenService:Create(ball, TweenInfo.new(0.2), {Rotation = 0}):Play()
        end

        ballToggleBtn.MouseButton1Click:Connect(function()
            ballSpinning = not ballSpinning
            if ballSpinning then
                ball.BackgroundColor3 = THEME.GreenSoft
                startBallSpin()
                setPhotoWindowVisible(true)
            else
                ball.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
                stopBallSpin()
                setPhotoWindowVisible(false)
            end
            API.Callbacks.OnBallToggle(ballSpinning) -- API: шарик включён/выключен
        end)

        y = y + 60

        ------------------------------------------------------------
        -- КНОПКИ ЭФФЕКТОВ (генерируются автоматически из таблицы EFFECTS)
        ------------------------------------------------------------
        addLabel(page, "// effect preview (применяется к 3D-модели выше)", y)
        y = y + 18

        local effectBtnWidth = 140
        local col = 0
        for _, effect in ipairs(EFFECTS) do
            local effectBtn = Instance.new("TextButton")
            effectBtn.Position = UDim2.new(0, col * (effectBtnWidth + 10), 0, y)
            effectBtn.Size = UDim2.new(0, effectBtnWidth, 0, 32)
            effectBtn.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
            effectBtn.AutoButtonColor = false
            effectBtn.Font = Enum.Font.RobotoMono
            effectBtn.TextSize = 13
            effectBtn.TextColor3 = THEME.Green
            effectBtn.Text = "[ " .. effect.Name .. " ]"
            effectBtn.ZIndex = 6
            effectBtn.Parent = page

            local ecCorner = Instance.new("UICorner")
            ecCorner.CornerRadius = UDim.new(0, 4)
            ecCorner.Parent = effectBtn
            local ecStroke = addBorder(effectBtn)

            animatePress(effectBtn, ecStroke)
            animateHover(effectBtn, Color3.fromRGB(6, 15, 10), THEME.GreenSoft)
            clickScan(effectBtn)

            effectBtn.MouseButton1Click:Connect(function()
                if charClone then
                    effect.Preview(charClone)
                end
                API.Callbacks.OnEffectTriggered(effect.Name) -- API: нажали кнопку эффекта
            end)

            col = col + 1
            if col >= 2 then
                col = 0
                y = y + 40
            end
        end
        if col ~= 0 then
            y = y + 40
        end

        -- Кнопка сброса: перезагружает чистую (не тронутую эффектом) копию персонажа
        local resetBtn = Instance.new("TextButton")
        resetBtn.Position = UDim2.new(0, 0, 0, y)
        resetBtn.Size = UDim2.new(0, effectBtnWidth, 0, 32)
        resetBtn.BackgroundColor3 = Color3.fromRGB(6, 15, 10)
        resetBtn.AutoButtonColor = false
        resetBtn.Font = Enum.Font.RobotoMono
        resetBtn.TextSize = 13
        resetBtn.TextColor3 = THEME.Green
        resetBtn.Text = "[ RESET PREVIEW ]"
        resetBtn.ZIndex = 6
        resetBtn.Parent = page

        local resetCorner = Instance.new("UICorner")
        resetCorner.CornerRadius = UDim.new(0, 4)
        resetCorner.Parent = resetBtn
        local resetStroke = addBorder(resetBtn)

        animatePress(resetBtn, resetStroke)
        animateHover(resetBtn, Color3.fromRGB(6, 15, 10), THEME.GreenSoft)
        clickScan(resetBtn)

        resetBtn.MouseButton1Click:Connect(function()
            loadCharacterPreview()
        end)

        y = y + 50
    end

    updatePageCanvas(page)

    pages[section.Name] = page
end

