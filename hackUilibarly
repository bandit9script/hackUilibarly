local function animatePress(button, stroke)
    local originalThickness = stroke and stroke.Thickness or 1
    local originalTransparency = stroke and stroke.Transparency or 0.3

    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.07, Enum.EasingStyle.Quad), {
            Size = button.Size - UDim2.new(0, 4, 0, 3)
        }):Play()
        if stroke then
            TweenService:Create(stroke, TweenInfo.new(0.07), {
                Transparency = 0,
                Thickness = originalThickness + 1.5
            }):Play()
        end
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = button.Size + UDim2.new(0, 4, 0, 3)
        }):Play()
        if stroke then
            TweenService:Create(stroke, TweenInfo.new(0.25), {
                Transparency = originalTransparency,
                Thickness = originalThickness
            }):Play()
        end
    end)
end

local function animateHover(button, baseColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = baseColor}):Play()
    end)
end

local function addBorder(button)
    local crisp = Instance.new("UIStroke")
    crisp.Color = THEME.Green
    crisp.Thickness = 1
    crisp.Transparency = 0.1
    crisp.LineJoinMode = Enum.LineJoinMode.Miter
    crisp.Parent = button
    return crisp
end

local function clickScan(button)
    button.MouseButton1Click:Connect(function()
        local flash = Instance.new("Frame")
        flash.BackgroundColor3 = THEME.Green
        flash.BackgroundTransparency = 0.6
        flash.BorderSizePixel = 0
        flash.Size = UDim2.new(0, 4, 1, 0)
        flash.Position = UDim2.new(0, 0, 0, 0)
        flash.ZIndex = button.ZIndex + 1
        flash.Parent = button

        local target = TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
            Position = UDim2.new(1, -4, 0, 0),
            BackgroundTransparency = 1,
        })
        target:Play()
        target.Completed:Connect(function()
            flash:Destroy()
        end)
    end)
end

local function typeText(label, fullText, charDelay)
    charDelay = charDelay or 0.012
    label.Text = ""
    task.spawn(function()
        for i = 1, #fullText do
            label.Text = string.sub(fullText, 1, i)
            task.wait(charDelay)
        end
    end)
end

