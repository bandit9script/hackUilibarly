-- Добавляй сюда свои эффекты. Для каждого эффекта под кнопкой автоматически
-- появится кнопка [ ИМЯ ]. При нажатии Preview(charClone) применяется к
-- клону персонажа, который крутится во вьюпорте.
-- charClone — это Model (обычный персонаж), внутри есть HumanoidRootPart,
-- Humanoid и все части тела/одежда, точно как у живого персонажа.
local EFFECTS = {
    {
        Name = "DEATH",
        Preview = function(charClone)
            -- ПРИМЕР эффекта смерти: частицы + окрашивание в красный + падение.
            -- Если у тебя уже есть готовый эффект (частица/анимация/звук),
            -- просто замени содержимое этой функции на свой код —
            -- charClone тебе доступен как обычная модель персонажа.
            local EFFECT_PARTICLE_ID = "rbxassetid://0" -- <-- ЗАМЕНИ 0 НА СВОЙ ID ЧАСТИЦЫ (если есть)

            local hrp = charClone:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local emitter = Instance.new("ParticleEmitter")
            emitter.Texture = EFFECT_PARTICLE_ID
            emitter.Color = ColorSequence.new(Color3.fromRGB(255, 30, 30))
            emitter.Lifetime = NumberRange.new(0.5, 1)
            emitter.Rate = 60
            emitter.Speed = NumberRange.new(2, 5)
            emitter.Parent = hrp
            task.delay(0.6, function()
                if emitter and emitter.Parent then
                    emitter.Enabled = false
                    task.delay(1, function()
                        if emitter then emitter:Destroy() end
                    end)
                end
            end)

            for _, part in ipairs(charClone:GetDescendants()) do
                if part:IsA("BasePart") then
                    TweenService:Create(part, TweenInfo.new(0.3), {Color = Color3.fromRGB(120, 0, 0)}):Play()
                end
            end

            local hum = charClone:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
            TweenService:Create(hrp, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                CFrame = hrp.CFrame * CFrame.Angles(math.rad(90), 0, 0)
            }):Play()
        end,
    },
    -- Добавляй свои эффекты сюда точно так же:
    -- {
    --     Name = "MY_EFFECT",
    --     Preview = function(charClone)
    --         -- твой код эффекта здесь
