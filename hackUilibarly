bootLabel.TextColor3 = THEME.Green
bootLabel.TextXAlignment = Enum.TextXAlignment.Left
bootLabel.TextYAlignment = Enum.TextYAlignment.Top
bootLabel.TextWrapped = true
bootLabel.Text = ""
bootLabel.ZIndex = 15
bootLabel.Parent = bootFrame

local BOOT_LINES = {
    "> connecting to bandit9.core ...",
    "> access token accepted",
    "> loading modules [player] [visual] [config] ...",
    "> decrypting interface ...",
    "> welcome, " .. (player.Name or "user"),
}

local function playBootSequence(onDone)
    bootFrame.Visible = true
    bootFrame.BackgroundTransparency = 0
    bootLabel.TextTransparency = 0
    bootLabel.Text = ""
    task.spawn(function()
        local full = ""
        for _, line in ipairs(BOOT_LINES) do
            for i = 1, #line do
                bootLabel.Text = full .. string.sub(line, 1, i) .. "_"
                task.wait(0.008)
            end
            full = full .. line .. "\n"
            bootLabel.Text = full
            task.wait(0.15)
        end
        task.wait(0.25)
        TweenService:Create(bootFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(bootLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        task.wait(0.3)
        bootFrame.Visible = false
        bootFrame.BackgroundTransparency = 0
        bootLabel.TextTransparency = 0
        if onDone then onDone() end
    end)
end

local SHUTDOWN_LINES = {
    "> saving session ...",
    "> closing modules [player] [visual] [config] ...",
    "> encrypting interface ...",
    "> connection terminated_",
}

local function playShutdownSequence(onDone)
    bootFrame.Visible = true
    bootFrame.BackgroundTransparency = 0
    bootLabel.TextTransparency = 0
    bootLabel.Text = ""
    task.spawn(function()
        local full = ""
        for _, line in ipairs(SHUTDOWN_LINES) do
            for i = 1, #line do
                bootLabel.Text = full .. string.sub(line, 1, i) .. "_"
                task.wait(0.006)
            end
            full = full .. line .. "\n"
            bootLabel.Text = full
            task.wait(0.12)
        end
        task.wait(0.15)
        if onDone then onDone() end
    end)
end

local function glitchShake(frame, duration)
    duration = duration or 0.25
    local originalPos = frame.Position
    task.spawn(function()
        local t = 0
        while t < duration do
            local dx = math.random(-4, 4)
            local dy = math.random(-3, 3)
            frame.Position = originalPos + UDim2.new(0, dx, 0, dy)
            task.wait(0.03)
            t = t + 0.03
        end
        frame.Position = originalPos
    end)
end

