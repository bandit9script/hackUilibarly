    label.Font = Enum.Font.RobotoMono
    label.TextSize = 16
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextColor3 = THEME.Green
    label.TextTransparency = 0.15
    label.TextWrapped = true
    label.RichText = true
    label.ZIndex = 1
    label.Parent = col

    local chars = {}
    for r = 1, 40 do
        chars[r] = MATRIX_CHARS:sub(math.random(1, #MATRIX_CHARS), math.random(1, #MATRIX_CHARS))
    end
    label.Text = table.concat(chars, "\n")

    columns[i] = {
        label = label,
        speed = math.random(40, 140) / 10, -- скорость падения
        offset = math.random(0, 1000),
    }
end

local matrixConn
local function startMatrix()
    if matrixConn then return end
    matrixConn = RunService.RenderStepped:Connect(function(dt)
        for _, c in ipairs(columns) do
            c.offset = c.offset + dt * c.speed * 20
            c.label.Position = UDim2.new(0, 0, 0, (c.offset % 800) - 800)
        end
    end)
end
local function stopMatrix()
    if matrixConn then
        matrixConn:Disconnect()
        matrixConn = nil
    end
end

