-- ПЕРЕТАСКИВАНИЕ ОКНА ФОТО (зажми ЛКМ / тап на окне и веди мышкой)
------------------------------------------------------------
photoGui.Active = true -- обязательно, чтобы Frame сам ловил InputBegan/InputChanged

local photoDragging = false
local photoDragInput
local photoDragStart
local photoStartPos

local function updatePhotoDrag(input)
    local delta = input.Position - photoDragStart
    photoGui.Position = UDim2.new(
        photoStartPos.X.Scale, photoStartPos.X.Offset + delta.X,
        photoStartPos.Y.Scale, photoStartPos.Y.Offset + delta.Y
    )
end

photoGui.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        photoDragging = true
        photoDragStart = input.Position
        photoStartPos = photoGui.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                photoDragging = false
            end
        end)
    end
end)

photoGui.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        photoDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == photoDragInput and photoDragging then
        updatePhotoDrag(input)
    end
end)

local PHOTO_SIZE = UDim2.new(0, 260, 0, 260)
local function setPhotoWindowVisible(visible)
    if visible then
        photoGui.Visible = true
        photoGui.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(photoGui, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = PHOTO_SIZE
        }):Play()
    else
        local tw = TweenService:Create(photoGui, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        tw:Play()
        tw.Completed:Connect(function()
            photoGui.Visible = false
        end)
    end
end

